{
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run test*)",
      "Bash(npm run typecheck*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma format*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose config*)",
      "Bash(docker ps*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "mcp__playwright",
      "mcp__shadcn"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout -b*)",
      "Bash(git switch -c*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(gh pr create*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker compose down -v*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Edit(/welinc-web-bms/**)",
      "Edit(/welinc-web-vmms/**)",
      "Edit(/welinc-backend-bms/**)",
      "Edit(/welinc-backend-vmms/**)"
    ]
  },
  "enabledMcpjsonServers": ["playwright", "shadcn", "atlassian"],
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
