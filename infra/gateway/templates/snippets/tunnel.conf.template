# VRMS spec 0025, AC-4, AC-5: what both public Sentry tunnel routes share. 05-check-env.sh writes the
# two locations (generated/monitoring.conf); each sets its own DSN parts ($tunnel_key, $tunnel_host,
# $tunnel_project) and its internal location ($tunnel_target), then includes this file. Not the
# shared route.conf: this one forwards no client address and has its own rate limit (zone tunnel,
# 1 a second per client, burst 10). The forwarding itself is in snippets/tunnel-forward.conf.

limit_req zone=tunnel burst=10 nodelay;

# The whole body (at most 1 MB) sits in one memory buffer, so njs can read the envelope header
client_max_body_size 1m;
client_body_buffer_size 1m;
client_body_in_single_buffer on;

# Answers the gateway makes here (405, 403) are JSON
types { }
default_type application/json;

# The SDK posts text/plain with no preflight, so only the allow origin header matters on a POST;
# an origin outside ALLOWED_ORIGINS gets none. These also land on the 403 from njs.
add_header Access-Control-Allow-Origin $cors_origin always;
add_header Vary Origin always;
add_header X-Request-Id $gateway_request_id always;
add_header Strict-Transport-Security "${GATEWAY_HSTS}" always;

# Both answered here, before the tunnel limit and without Sentry. An if block drops the headers
# above, so each repeats them on purpose.
if ($request_method = OPTIONS) {
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods $tunnel_methods always;
    add_header Access-Control-Allow-Headers $tunnel_request_headers always;
    add_header Access-Control-Max-Age $cors_max_age always;
    add_header Vary Origin always;
    add_header X-Request-Id $gateway_request_id always;
    add_header Strict-Transport-Security "${GATEWAY_HSTS}" always;
    return 204;
}
if ($request_method != POST) {
    add_header Allow "POST, OPTIONS" always;
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Vary Origin always;
    add_header X-Request-Id $gateway_request_id always;
    add_header Strict-Transport-Security "${GATEWAY_HSTS}" always;
    return 405 '{"statusCode":405,"message":"Only POST is allowed here","error":"Method Not Allowed","code":"METHOD_NOT_ALLOWED"}';
}

# Reads the envelope header and forwards to $tunnel_target only when its dsn is this route's own;
# anything else answers 403 TUNNEL_REJECTED (njs/tunnel.js)
js_content tunnel.check;
