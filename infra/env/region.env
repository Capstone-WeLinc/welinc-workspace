# Read by infra/scripts/*.sh. Picked in task 13 after the quota check in the trial subscription
# (2026-11-19): it allows one Container Apps environment per region, so production can't share
# staging's region. Staging and the shared registry run in Southeast Asia (closest to the users);
# production runs in East Asia, about the same distance. Both regions offer PostgreSQL B1ms to it.
LOCATION=southeastasia
POSTGRES_LOCATION=southeastasia
PROD_LOCATION=eastasia
PROD_POSTGRES_LOCATION=eastasia
# The trial blocks ACR Tasks (TasksOperationsNotAllowed), so no purge task on the registry:
# .github/workflows/purge-images.yml runs scripts/purge-images.sh every Sunday instead.
PURGE_TASK=false
