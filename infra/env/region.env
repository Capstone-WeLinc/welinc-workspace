# Read by infra/scripts/*.sh. Picked in task 13 after the quota check in the trial subscription
# (2026-11-19). The trial allows one Container Apps environment in the whole subscription, so
# production's apps run in staging's environment (cae-welinc-staging) and must share its region:
# everything runs in Southeast Asia (closest to the users; B1ms is offered there to the trial).
LOCATION=southeastasia
POSTGRES_LOCATION=southeastasia
PROD_LOCATION=southeastasia
PROD_POSTGRES_LOCATION=southeastasia
# The trial blocks ACR Tasks (TasksOperationsNotAllowed), so no purge task on the registry:
# .github/workflows/purge-images.yml runs scripts/purge-images.sh every Sunday instead.
PURGE_TASK=false
