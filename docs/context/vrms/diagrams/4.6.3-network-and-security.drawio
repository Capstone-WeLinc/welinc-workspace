<mxfile host="drawio"><diagram name="4.6.3 Network and security" id="4.6.3 Network and security"><mxGraphModel grid="1" gridSize="10" guides="1" page="0" pageWidth="1460" pageHeight="820" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="VRMS network and security" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1460" height="40" as="geometry"/></mxCell><mxCell id="z1" value="Internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748B;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="260" height="740" as="geometry"/></mxCell><mxCell id="z2" value="Public entry (HTTPS only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748B;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="310" y="60" width="300" height="740" as="geometry"/></mxCell><mxCell id="z3" value="Private network (Container Apps environment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E8B800;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="420" height="740" as="geometry"/></mxCell><mxCell id="z4" value="Data services (no public sign in)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748B;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1090" y="60" width="350" height="740" as="geometry"/></mxCell><mxCell id="user" value="Browser" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#0F172A;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="56" height="56" as="geometry"/></mxCell><mxCell id="swa" value="VRMS web app&#xa;(Static Web App)" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#0F172A;image=img/lib/azure2/preview/Static_Apps.svg;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="56" height="56" as="geometry"/></mxCell><mxCell id="gw" value="API gateway&#xa;staging-api.welinc.app" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#0F172A;image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="56" height="56" as="geometry"/></mxCell><mxCell id="be" value="VRMS backend" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#0F172A;image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="56" height="56" as="geometry"/></mxCell><mxCell id="auth" value="WeLinc sign in service" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#0F172A;image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="1"><mxGeometry x="940" y="180" width="56" height="56" as="geometry"/></mxCell><mxCell id="mi" value="Managed identity&#xa;of the backend" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#0F172A;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="760" y="520" width="56" height="56" as="geometry"/></mxCell><mxCell id="pg" value="PostgreSQL" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#0F172A;image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" vertex="1" parent="1"><mxGeometry x="1240" y="290" width="56" height="56" as="geometry"/></mxCell><mxCell id="st" value="Blob storage&#xa;vrms-attachments" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#0F172A;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1240" y="470" width="56" height="56" as="geometry"/></mxCell><mxCell id="c1" value="• HTTPS with managed certificates&#xa;• Strict transport security (HSTS)&#xa;• Allowed origins only (CORS)&#xa;• Rate limit per client&#xa;• Upload size limit" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="260" height="130" as="geometry"/></mxCell><mxCell id="c2" value="• Every request: signed token checked&#xa;   against the sign in service keys&#xa;• Session still active (checked every 30 s)&#xa;• Permission check on every action&#xa;• Login cookie: HttpOnly, Secure&#xa;• Apps reachable only from the gateway" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="660" y="620" width="390" height="150" as="geometry"/></mxCell><mxCell id="c3" value="• PostgreSQL: SSL required, firewall&#xa;   allows Azure services only&#xa;• Storage: no public access,&#xa;   shared keys off, private container&#xa;• Backend may write only its own&#xa;   container (managed identity role)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1105" y="95" width="330" height="150" as="geometry"/></mxCell><mxCell id="c4" value="• Access token kept in memory only&#xa;• Photos opened with read only&#xa;   links that expire in 10 to 20 min" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="75" y="470" width="200" height="130" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#0F172A;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#0F172A;edgeStyle=none;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="swa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="HTTPS (443)" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#0F172A;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#0F172A;edgeStyle=none;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="internal HTTPS" style="html=1;rounded=1;endArrow=block;endFill=1;endSize=7;strokeColor=#0F172A;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#0F172A;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="be"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="token keys,&#xa;session check" style="html=1;rounded=1;endArrow=block;endFill=1;