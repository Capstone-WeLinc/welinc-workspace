# Service repos are cloned separately (scripts/clone-all.sh)
/welinc-*/

# Env files: only examples are committed
.env
.env.*
!.env.example

# Raw source exports (Google Docs, Jira CSV)
docs/_source/

# Private notes a group keeps out of git (docs/_private/<system>/)
docs/_private/

# Playwright MCP screenshots, snapshots and downloads
.playwright-mcp/

# Personal Claude Code overrides
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Impeccable critique snapshots
.impeccable/

# Per group AI setup: installed locally from agents/<system>/ by scripts/use-agents.mjs, never committed
/.claude/skills/
/.claude/agents-installed.json
/.agents/
/.mcp.json
/CLAUDE.local.md
/skills-lock.json
/test-preferences.json
